# Базовый официальный образ Airflow — та же версия, что уже используется
# в docker-compose.yml (2.10.4), чтобы не расходиться с уже поднятой metadata-БД.
FROM apache/airflow:2.10.4

# Устанавливаем от пользователя airflow (UID 50000), НЕ root — так же,
# как и в базовом образе. Ставить Python-пакеты через pip от root в этом
# образе запрещено намеренно (constraint самого Airflow), поэтому USER
# не трогаем.

# astronomer-cosmos — транслирует dbt-проект (через manifest.json) в
# отдельные Airflow-таски, по одной на каждую dbt-модель.
# dbt-postgres — конкретный адаптер dbt под наш Postgres DWH.
#
# astronomer-cosmos ставим в основное окружение Airflow — он сам по себе
# лёгкий и совместим с constraints самого Airflow.
RUN pip install --no-cache-dir astronomer-cosmos==1.9.1

# dbt-core/dbt-postgres НЕ ставим в основное окружение: у dbt большой
# собственный стек зависимостей, который может конфликтовать по версиям
# с тем, что уже жёстко закреплено в базовом образе Airflow (constraints
# apache/airflow). Из-за этого pip мог уходить в долгий backtracking,
# пытаясь согласовать ОБА набора зависимостей разом.
# Решение — изолированный venv только для dbt, cosmos обращается к нему
# как к внешнему исполняемому файлу (dbt_executable_path), а не как
# к Python-библиотеке в том же окружении.
RUN python -m venv /opt/airflow/dbt_venv && \
    /opt/airflow/dbt_venv/bin/pip install --no-cache-dir \
    dbt-core==1.12.0 \
    dbt-postgres==1.11.0
